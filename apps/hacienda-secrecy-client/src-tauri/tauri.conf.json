{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hacienda Secrecy Client",
  "version": "0.1.0",
  "identifier": "io.hacienda.secrecy-client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Hacienda Secrecy Client",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
