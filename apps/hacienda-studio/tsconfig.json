{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Inherits target ES2022 from the workspace root; esbuild rejects ES2024
    // when it reads it back out of tsconfig, and no ES2024 syntax is in use.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "wicg-file-system-access"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      // `tesseract-wasm`'s package.json has an `exports` map with no `types`
      // condition on it, and a top-level `types` field doesn't count once
      // `exports` is present under `moduleResolution: "bundler"` — so TS can't
      // find its declarations via normal resolution. Point straight at them;
      // this only affects type-checking, Vite/esbuild still resolve the real
      // `exports` map at runtime.
      "tesseract-wasm": ["./node_modules/tesseract-wasm/dist/index.d.ts"]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "app.d.ts",
    "lib/**/*",
    "worker/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
