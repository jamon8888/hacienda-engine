# hacienda Node NAPI Dockerfile (musl)
# syntax = docker/dockerfile:1.7

FROM rust:1.78-slim AS planner
WORKDIR /app
RUN cargo install cargo-chef --locked
COPY . .
RUN cargo chef prepare --workspace --recipe-path recipe.json

FROM rust:1.78-slim AS builder
WORKDIR /app
RUN cargo install cargo-chef --locked
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --workspace --recipe-path recipe.json

COPY . .
RUN cargo build --release --workspace --bin hacienda-node

FROM gcr.io/distroless/cc-debian12:nonroot AS runtime
WORKDIR /app

COPY --from=builder /app/target/release/hacienda-node /app/hacienda-node

USER nonroot:nonroot

ENTRYPOINT ["/app/hacienda-node"]